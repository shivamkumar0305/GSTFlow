DEBUG=False
SECRET_KEY=replace-with-a-long-random-secret
DB_NAME=gstflow
DB_USER=postgres
DB_PASSWORD=replace-with-a-strong-database-password
DB_HOST=postgres
DB_PORT=5432
# Use "require" for managed PostgreSQL services such as Supabase.
DB_SSLMODE=
DB_CONN_MAX_AGE=60
# Celery & Cache: Set CELERY_TASK_ALWAYS_EAGER=True when deploying without Redis (e.g. on Render)
# If Redis is available, provide REDIS_CACHE_URL and set CELERY_TASK_ALWAYS_EAGER=False
CELERY_TASK_ALWAYS_EAGER=True
# CELERY_BROKER_URL=redis://redis:6379/0
# CELERY_RESULT_BACKEND=redis://redis:6379/0
# REDIS_CACHE_URL=redis://redis:6379/1
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
AI_EXPLANATIONS_ENABLED=True
RECONCILIATION_VALUE_TOLERANCE=1.0
ALLOWED_HOSTS=your-domain.example
CORS_ALLOWED_ORIGINS=https://your-domain.example
CSRF_TRUSTED_ORIGINS=https://your-domain.example
FORCE_HTTPS=True
MAX_UPLOAD_SIZE_MB=10
