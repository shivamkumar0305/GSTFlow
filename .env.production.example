# Copy to .env.production, then replace every placeholder before deployment.
DEBUG=False
SECRET_KEY=replace-with-output-of-python-secrets-token-urlsafe-64

DB_NAME=gstflow
DB_USER=gstflow
DB_PASSWORD=replace-with-a-strong-database-password
DB_HOST=postgres
DB_PORT=5432
# Set to require when using a managed PostgreSQL service such as Supabase.
DB_SSLMODE=
DB_CONN_MAX_AGE=60

# Celery & Cache: Set CELERY_TASK_ALWAYS_EAGER=True when deploying without Redis (e.g. on Render)
# If Redis is available, provide REDIS_CACHE_URL and set CELERY_TASK_ALWAYS_EAGER=False
CELERY_TASK_ALWAYS_EAGER=True
# CELERY_BROKER_URL=redis://redis:6379/0
# CELERY_RESULT_BACKEND=redis://redis:6379/0
# REDIS_CACHE_URL=redis://redis:6379/1

# Set DOMAIN to the public DNS name when using the optional Caddy TLS profile.
DOMAIN=gstflow.example.com
ALLOWED_HOSTS=gstflow.example.com
CORS_ALLOWED_ORIGINS=https://gstflow.example.com
CSRF_TRUSTED_ORIGINS=https://gstflow.example.com
FORCE_HTTPS=True
PUBLIC_PORT=3000

MAX_UPLOAD_SIZE_MB=10
RECONCILIATION_VALUE_TOLERANCE=1.0

# Optional. Without a key, template explanations remain available.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
AI_EXPLANATIONS_ENABLED=True
